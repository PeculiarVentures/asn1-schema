{
  "name": "asn1-schema-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@peculiar/utils": "^2.0.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "lerna": "^10.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "test": "vitest run",
    "build": "lerna run build",
    "rebuild": "lerna run rebuild",
    "clear": "lerna run --parallel clear",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "create": "node scripts/create_package.mjs",
    "prepub": "npm run build",
    "pub": "lerna publish",
    "coverage": "vitest run --coverage"
  }
}
